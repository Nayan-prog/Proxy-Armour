# Copy to .env (git-ignored) and fill in. Every variable is optional; leaving one
# empty disables the feature that needs it - the proxy and /scan keep working.

# PostgreSQL for the audit log and policies (SQLAlchemy URL, psycopg v3 driver).
# Create the schema with:  alembic upgrade head
DATABASE_URL=postgresql+psycopg://armour:change-me@127.0.0.1:5432/proxy_armour

# Redis for live counters and the dashboard live feed (optional).
REDIS_URL=redis://127.0.0.1:6379/0

# Admin login for the dashboard. Store the bcrypt HASH, never the password.
# Generate with:  python -m app.hash_password
# Keep the single quotes - the hash contains $ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$replace.with.output.of.python.-m.app.hash_password'

# Signs admin JWTs (HS256). At least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Shared secret the proxy sends in X-Armour-Secret to POST /events and
# GET /internal/policies. Same value for the proxy and the API. Generate as above.
EVENTS_SHARED_SECRET=
